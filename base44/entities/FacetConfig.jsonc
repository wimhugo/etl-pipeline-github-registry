{
  "name": "FacetConfig",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display label shown as the facet header"
    },
    "field_key": {
      "type": "string",
      "description": "Field on the Policy data model used as the basis for this facet (e.g. odrl_type, status, creator)"
    },
    "facet_type": {
      "type": "string",
      "enum": [
        "pills",
        "search_list",
        "chart",
        "timeline",
        "map"
      ],
      "default": "pills",
      "description": "Rendering type for this facet"
    },
    "chart_subtype": {
      "type": "string",
      "enum": [
        "bar",
        "pie",
        "donut",
        "line"
      ],
      "default": "bar",
      "description": "Chart sub-type (only relevant when facet_type=chart)"
    },
    "default_logic": {
      "type": "string",
      "enum": [
        "OR",
        "AND"
      ],
      "default": "OR",
      "description": "Default boolean logic for multi-select facets"
    },
    "max_visible_items": {
      "type": "number",
      "default": 6,
      "description": "Maximum items shown before scrolling is activated"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this facet is shown in the filter panel"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the filter panel (ascending)"
    },
    "context": {
      "type": "string",
      "enum": [
        "policies",
        "actions",
        "constraints"
      ],
      "default": "policies",
      "description": "Which KB entity list this facet applies to"
    }
  },
  "required": [
    "title",
    "field_key",
    "facet_type"
  ]
}