{
  "name": "GlobalConfig",
  "type": "object",
  "properties": {
    "github_token": {
      "type": "string",
      "description": "GitHub Personal Access Token (PAT)"
    },
    "github_username": {
      "type": "string",
      "description": "GitHub username (optional)"
    },
    "github_repo": {
      "type": "string",
      "description": "Default GitHub repository (owner/repo)"
    },
    "github_branch": {
      "type": "string",
      "default": "main",
      "description": "Default branch"
    },
    "github_configs_folder": {
      "type": "string",
      "default": ".openrel/pipelines"
    },
    "github_output_folder": {
      "type": "string",
      "default": "data"
    },
    "namespace": {
      "type": "string",
      "default": "openrel"
    },
    "kb_search_data_url": {
      "type": "string",
      "default": "https://raw.githubusercontent.com/wimhugo/openrel/main/data/input/v0.3",
      "description": "Base URL for the KB Search data folder (raw GitHub content URL)"
    },
    "kb_search_data_api_url": {
      "type": "string",
      "default": "https://api.github.com/repos/wimhugo/openrel/contents/data/input/v0.3",
      "description": "GitHub API URL for listing files in the KB Search data folder"
    },
    "kb_policy_file": {
      "type": "string",
      "description": "Selected policy file name for KB Search"
    },
    "kb_sub_entity_files": {
      "type": "object",
      "description": "Map of sub-entity type -> selected filename, e.g. { actions: 'actions.json' }",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": []
}