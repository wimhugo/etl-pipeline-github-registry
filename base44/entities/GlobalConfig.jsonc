{
  "name": "GlobalConfig",
  "type": "object",
  "properties": {
    "github_token": {
      "type": "string",
      "description": "GitHub Personal Access Token (PAT)"
    },
    "github_username": {
      "type": "string",
      "description": "GitHub username (optional)"
    },
    "github_repo": {
      "type": "string",
      "description": "Default GitHub repository (owner/repo)"
    },
    "github_branch": {
      "type": "string",
      "default": "main",
      "description": "Default branch"
    },
    "github_configs_folder": {
      "type": "string",
      "default": ".openrel/pipelines"
    },
    "github_output_folder": {
      "type": "string",
      "default": "data"
    },
    "namespace": {
      "type": "string",
      "default": "openrel"
    },
    "kb_search_data_url": {
      "type": "string",
      "default": "https://raw.githubusercontent.com/wimhugo/openrel/main/data/input/v0.3",
      "description": "Base URL for the KB Search data folder (raw GitHub content URL)"
    },
    "kb_search_data_api_url": {
      "type": "string",
      "default": "https://api.github.com/repos/wimhugo/openrel/contents/data/input/v0.3",
      "description": "GitHub API URL for listing files in the KB Search data folder"
    },
    "kb_policy_file": {
      "type": "string",
      "description": "Selected policy file name for KB Search"
    },
    "kb_sub_entity_files": {
      "type": "object",
      "description": "Map of sub-entity type -> selected filename, e.g. { actions: 'actions.json' }",
      "additionalProperties": {
        "type": "string"
      }
    },
    "badge_mapping_file": {
      "type": "string",
      "description": "GitHub path where badge mappings YAML file is stored"
    },
    "badge_mappings": {
      "type": "array",
      "description": "Array of badge mapping sections, each with a context name and rows",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Section context name (e.g. 'User', 'Agent', 'Resource')"
          },
          "rows": {
            "type": "array",
            "description": "Array of badge mapping rows in this section",
            "items": {
              "type": "object",
              "properties": {
                "profileBadge": {
                  "type": "string",
                  "description": "Human-readable label shown in the User Profile"
                },
                "contextBadge": {
                  "type": "string",
                  "description": "Internal context/verification status key"
                },
                "colour": {
                  "type": "string",
                  "description": "Badge colour token"
                },
                "constraintMapping": {
                  "type": "string",
                  "description": "Comma-separated constraint keys"
                }
              }
            }
          }
        },
        "required": [
          "name",
          "rows"
        ]
      }
    }
  },
  "required": []
}