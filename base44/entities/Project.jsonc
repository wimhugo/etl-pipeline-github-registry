{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string",
      "description": "Short description of this project"
    },
    "trl": {
      "type": "number",
      "description": "Technology Readiness Level (1\u20139)"
    },
    "github_code_repo": {
      "type": "string",
      "description": "URL to the source code repository (e.g. https://github.com/org/openrel)"
    },
    "github_token": {
      "type": "string",
      "description": "GitHub Personal Access Token for this project"
    },
    "github_username": {
      "type": "string",
      "description": "GitHub username (optional)"
    },
    "github_repo": {
      "type": "string",
      "description": "Default GitHub repository (owner/repo) \u2014 target data repo"
    },
    "github_branch": {
      "type": "string",
      "default": "main",
      "description": "Default branch"
    },
    "github_configs_folder": {
      "type": "string",
      "default": ".openrel/pipelines",
      "description": "Folder in GitHub where pipeline YAML configs are stored"
    },
    "github_output_folder": {
      "type": "string",
      "default": "data",
      "description": "Default output folder in GitHub"
    },
    "namespace": {
      "type": "string",
      "default": "openrel",
      "description": "Namespace prefix"
    }
  },
  "required": [
    "name"
  ]
}