{
  "name": "VocabularyLink",
  "type": "object",
  "properties": {
    "vocabulary_source_id": {
      "type": "string",
      "description": "Reference to the VocabularySource that provides the controlled vocabulary"
    },
    "target_entity": {
      "type": "string",
      "description": "The entity name this vocabulary applies to (e.g., 'Policy', 'Action', 'Constraint')"
    },
    "target_field": {
      "type": "string",
      "description": "The specific field path in the target entity (e.g., 'status', 'odrl_type', 'action.type')"
    },
    "display_label": {
      "type": "string",
      "description": "Human-readable label for this field in forms (e.g., 'Policy Status', 'Action Type')"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this field is required in forms"
    },
    "allow_multiple": {
      "type": "boolean",
      "default": false,
      "description": "Whether multiple values can be selected (multi-select)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order when multiple vocabularies are shown"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this vocabulary link is currently active"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes or documentation about this vocabulary usage"
    }
  },
  "required": [
    "vocabulary_source_id",
    "target_entity",
    "target_field"
  ]
}