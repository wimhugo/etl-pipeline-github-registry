{
  "name": "ApiSourceFile",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "API section name (e.g. 'Actions', 'Constraints', 'Policies')"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this API section"
    },
    "file_path": {
      "type": "string",
      "description": "GitHub file path to the source file (e.g. .openrel/vocabs/openrel/actions.ttl)"
    },
    "data_format": {
      "type": "string",
      "enum": [
        "ttl",
        "json",
        "json-ld",
        "yaml"
      ],
      "default": "ttl",
      "description": "Format of the source file"
    },
    "member_identifier": {
      "type": "string",
      "default": "skos:Concept",
      "description": "Identifier used to recognize members/instances in the source file (e.g. 'skos:Concept' for concept schemes, or a class IRI for instance lists)"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "System-generated source file (e.g. Mappings). Read-only in the UI; not synced as a mapping source."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this source file is active"
    }
  },
  "required": [
    "section",
    "file_path"
  ]
}