{
  "name": "ApiSourceFile",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "description": "API section name (e.g. 'Actions', 'Constraints', 'Policies')"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "Registry",
        "Schema",
        "Vocabulary",
        "Example"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "default": "Registry",
      "description": "Label grouping this source belongs to: Registry (vocabularies of terms), Schema (OPENREL classes and properties), Vocabulary (controlled lists), Example (worked policy examples)."
    },
    "description": {
      "type": "string",
      "description": "Optional description of this API section"
    },
    "source_mode": {
      "type": "string",
      "enum": [
        "file",
        "folder"
      ],
      "default": "file",
      "description": "file = parse members from the listed source file(s); folder = each TTL file in the folder is a member"
    },
    "file_path": {
      "type": "string",
      "description": "GitHub path to the source file (file mode) OR the folder containing per-member TTL files (folder mode). In file mode several paths may be listed, separated by commas or newlines; members from all of them are merged."
    },
    "data_format": {
      "type": "string",
      "enum": [
        "ttl",
        "json",
        "json-ld",
        "yaml"
      ],
      "default": "ttl",
      "description": "Format of the source file (file mode)"
    },
    "member_identifier": {
      "type": "string",
      "default": "skos:Concept",
      "description": "Identifier used to recognize members/instances in the source file (file mode only). Several types may be listed, comma-separated (e.g. 'rdfs:Class,owl:Class'); a subject is a member when it matches any of them."
    },
    "id_prefix": {
      "type": "string",
      "description": "Folder mode: when set, the list/detail ID replaces the resolved @base with this prefix (e.g. 'openrel:'). When empty, the full resolved subject IRI is used."
    },
    "title_field": {
      "type": "string",
      "default": "dct:title",
      "description": "Folder mode: property used as the list label (CURIE or full IRI). Defaults to dct:title."
    },
    "description_field": {
      "type": "string",
      "default": "dct:description",
      "description": "Folder mode: property used as the list definition (CURIE or full IRI). Defaults to dct:description."
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "System-generated source file (e.g. Mappings). Read-only in the UI; not synced as a mapping source."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this source file is active"
    }
  },
  "required": [
    "section",
    "file_path"
  ]
}