{
  "name": "UserScenario",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Name of this user scenario"
    },
    "description": {
      "type": "string",
      "description": "Short description of what this scenario covers"
    },
    "selected_scenario_ids": {
      "type": "array",
      "description": "IDs of selected scenarios",
      "items": {
        "type": "string"
      }
    },
    "saved_matches": {
      "type": "array",
      "description": "Saved policy match results from the last Match run",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "saved_matches_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when matches were last saved"
    }
  },
  "required": [
    "label"
  ]
}