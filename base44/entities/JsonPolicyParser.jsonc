{
  "name": "JsonPolicyParser",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of this parser configuration"
    },
    "description": {
      "type": "string",
      "description": "Optional description of what this pipeline converts"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "text",
        "file"
      ],
      "default": "text",
      "description": "Whether the JSON input is an inline text blob or fetched from a URL"
    },
    "json_text": {
      "type": "string",
      "description": "Inline JSON text blob (when input_type=text)"
    },
    "input_file_url": {
      "type": "string",
      "description": "URL of the input JSON file (when input_type=file)"
    },
    "github_target_folder": {
      "type": "string",
      "description": "Target folder path in the GitHub repository (e.g. .openrel/vocabs/openrel)"
    },
    "github_target_file": {
      "type": "string",
      "description": "Target filename including extension (e.g. policies.ttl)"
    },
    "github_branch": {
      "type": "string",
      "default": "main",
      "description": "GitHub branch to write to"
    },
    "namespace": {
      "type": "string",
      "default": "openrel",
      "description": "Default namespace prefix for terms without an explicit prefix"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last execution"
    },
    "last_run_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "pending",
      "description": "Status of the last execution"
    },
    "last_run_message": {
      "type": "string",
      "description": "Summary or error message from the last execution"
    },
    "last_pr_url": {
      "type": "string",
      "description": "URL of the pull request created by the last execution"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this configuration is active"
    }
  },
  "required": [
    "name"
  ]
}