{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "Administrator",
        "Curator",
        "Contributor",
        "End User"
      ],
      "default": "Contributor",
      "description": "User role determining feature access"
    },
    "orcid": {
      "type": "string",
      "description": "ORCID iD of the researcher (e.g. 0000-0002-1825-0097)"
    },
    "orcid_institutions": {
      "type": "array",
      "description": "List of institutions retrieved from ORCID",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "start_year": {
            "type": "string"
          },
          "end_year": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "employment or education"
          }
        }
      }
    },
    "default_institution": {
      "type": "string",
      "description": "Name of the default/primary institution"
    },
    "locations": {
      "type": "array",
      "description": "Geographic locations sourced from ORCID, ROR, or entered manually",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Country name or ISO code"
          },
          "source": {
            "type": "string",
            "description": "Source: orcid, ror, or manual"
          }
        }
      }
    },
    "default_location": {
      "type": "string",
      "description": "The selected default geographic location"
    },
    "location": {
      "type": "string",
      "description": "Legacy single location field (kept for backwards compatibility)"
    }
  },
  "required": []
}