{
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the ETL pipeline"
    },
    "description": {
      "type": "string",
      "description": "Description of what the pipeline does"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "error",
        "draft"
      ],
      "default": "draft"
    },
    "inventory_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, all transformed records are bundled into a single inventory JSON file instead of individual files"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "csv",
        "txt",
        "json"
      ],
      "default": "csv",
      "description": "Type of input file"
    },
    "output_type": {
      "type": "string",
      "enum": [
        "json",
        "csv"
      ],
      "default": "json",
      "description": "Type of output file"
    },
    "source_file_url": {
      "type": "string",
      "description": "URL of the uploaded source file"
    },
    "source_file_name": {
      "type": "string",
      "description": "Original filename of the source"
    },
    "source_fields": {
      "type": "array",
      "description": "Detected fields/columns from the source file",
      "items": {
        "type": "string"
      }
    },
    "source_record_count": {
      "type": "number",
      "description": "Number of top-level records detected in the source file"
    },
    "template": {
      "type": "string",
      "description": "JSON or JSON-LD template content"
    },
    "template_file_name": {
      "type": "string",
      "description": "Name of the template file"
    },
    "template_fields": {
      "type": "array",
      "description": "Fields detected from the template",
      "items": {
        "type": "string"
      }
    },
    "field_mapping": {
      "type": "object",
      "description": "Mapping of template fields to source fields: { templateField: sourceField }",
      "additionalProperties": {
        "type": "string"
      }
    },
    "github_repo": {
      "type": "string",
      "description": "Target GitHub repository (owner/repo)"
    },
    "github_branch": {
      "type": "string",
      "default": "main",
      "description": "Target branch"
    },
    "github_target_folder": {
      "type": "string",
      "description": "Target folder path in the GitHub repo"
    },
    "github_config_path": {
      "type": "string",
      "description": "Path where the pipeline config YAML is stored in GitHub"
    },
    "output_inventory": {
      "type": "array",
      "description": "List of files created/updated in GitHub by this pipeline",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "string",
      "enum": [
        "manual",
        "every_5min",
        "every_15min",
        "hourly",
        "daily",
        "weekly"
      ],
      "default": "manual"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_run_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "running",
        "cancelled"
      ]
    },
    "total_runs": {
      "type": "number",
      "default": 0
    },
    "success_rate": {
      "type": "number",
      "default": 0
    },
    "namespace": {
      "type": "string",
      "default": "openrel"
    }
  },
  "required": [
    "name"
  ]
}